{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "template-api",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true
  }
  // No Hyperdrive block here on purpose: the id is account-specific. Put it in
  // a gitignored .env as HYPERDRIVE_ID and `pnpm run deploy` binds it as
  // HYPERDRIVE (see .env.example and scripts/wrangler-deploy.mjs).
  //
  // Without it, the Worker connects over a DATABASE_URL secret instead:
  //   wrangler secret put DATABASE_URL
  //
  // For `wrangler dev`, put DATABASE_URL in .dev.vars.
}
