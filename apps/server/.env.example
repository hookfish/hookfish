# Copy to apps/server/.env and fill in. Never commit the real file.
#
#   cp apps/server/.env.example apps/server/.env
#
# Local API (pnpm --filter @template/server dev) reads this file directly.
# For deployed Workers / the frontend `/api` mount, push each value as a secret:
#
#   pnpm wrangler secret put OAUTH_ENCRYPTION_KEY

# --- Broker -----------------------------------------------------------------

# Encrypts access/refresh tokens and provider client secrets before they are
# written to the database.
# Generate with: openssl rand -base64 32
# Changing this makes every stored secret unreadable.
OAUTH_ENCRYPTION_KEY=

# Callers must send `Authorization: Bearer <this>` on every endpoint except
# the OAuth callback. Generate with: openssl rand -base64 32
# Outside production, defaults to "test" when unset.
BROKER_API_KEY=

# Public origin the providers redirect back to. Callback URLs are derived as
# <base>/api/oauth/<provider>/callback. Leave unset locally to use the origin
# of the incoming request.
# OAUTH_REDIRECT_BASE_URL=https://broker.example.com

# --- Database ---------------------------------------------------------------

# Leave unset for local Node API (`pnpm dev` / standalone server): PGlite uses ./pgdata.
# Set it for Workers production / `dev:worker` -- PGlite cannot persist inside workerd.
# DATABASE_URL=postgres://user:pass@host/db
# PGLITE_DATA_DIR=./pgdata

# Provider client_id / client_secret are registered over the API
# (POST /api/oauth/providers), not via env vars.
