# Copy to apps/server/.env and fill in. Never commit the real file.
#
#   cp apps/server/.env.example apps/server/.env
#
# Local API (pnpm --filter @template/server dev) reads this file directly.
# For deployed Workers / the frontend `/api` mount, push each value as a secret:
#
#   pnpm wrangler secret put NOTION_CLIENT_SECRET

# --- Broker -----------------------------------------------------------------

# Encrypts access/refresh tokens before they are written to the database.
# Generate with: openssl rand -base64 32
# Changing this makes every stored token unreadable.
OAUTH_ENCRYPTION_KEY=

# Callers must send `Authorization: Bearer <this>` on every endpoint except
# the OAuth callback. Generate with: openssl rand -base64 32
# Outside production, defaults to "test" when unset.
BROKER_API_KEY=

# Public origin the providers redirect back to. Callback URLs are derived as
# <base>/api/oauth/<provider>/callback. Local portless sets this automatically
# to whichever host it proxies (branch-prefixed off `main`). Leave unset in
# production to use the request origin, or set it explicitly for Workers.
# OAUTH_REDIRECT_BASE_URL=https://broker.example.com

# --- Database ---------------------------------------------------------------

# Leave unset for local Node API (`pnpm dev` / standalone server): PGlite uses ./pgdata.
# Set it for Workers production / `dev:worker` -- PGlite cannot persist inside workerd.
# DATABASE_URL=postgres://user:pass@host/db
# PGLITE_DATA_DIR=./pgdata

# --- Providers --------------------------------------------------------------
# Only the providers you fill in show up as `configured: true`.
# <ID>_SCOPES is optional and overrides the defaults in packages/api/src/oauth/providers.ts.
#
# For the redirect URI to register in each console, ask the running broker --
# the host varies by branch and by how you reach the API, and providers match
# it byte for byte:
#   curl -H "Authorization: Bearer $BROKER_API_KEY" <origin>/api/oauth/providers

# https://www.notion.so/profile/integrations -> public integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# https://linear.app/settings/api/applications
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# LINEAR_SCOPES=read,write

# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_SCOPES=openid email profile
