# Copy to apps/server/.env and fill in. Never commit the real file.
#
#   cp apps/server/.env.example apps/server/.env
#
# Local dev (pnpm dev) reads this file directly. For deployed Workers,
# push each value as a secret instead:
#
#   pnpm wrangler secret put NOTION_CLIENT_SECRET

# --- Broker -----------------------------------------------------------------

# Encrypts access/refresh tokens before they are written to the database.
# Generate with: openssl rand -base64 32
# Changing this makes every stored token unreadable.
OAUTH_ENCRYPTION_KEY=

# Callers must send `Authorization: Bearer <this>` on every endpoint except
# the OAuth callback. Generate with: openssl rand -base64 32
BROKER_API_KEY=

# Public origin the providers redirect back to. Callback URLs are derived as
# <base>/api/oauth/<provider>/callback. Leave unset locally to use the origin
# of the incoming request.
# OAUTH_REDIRECT_BASE_URL=https://broker.example.com

# --- Database ---------------------------------------------------------------

# Leave unset for local dev: `pnpm dev` runs PGlite against ./pgdata.
# Set it for `pnpm dev:worker` and production -- PGlite cannot persist inside
# workerd, so the Worker needs real Postgres over HTTP.
# DATABASE_URL=postgres://user:pass@host/db
# PGLITE_DATA_DIR=./pgdata

# --- Providers --------------------------------------------------------------
# Only the providers you fill in show up as `configured: true`.
# <ID>_SCOPES is optional and overrides the defaults in src/oauth/providers.ts.

# https://www.notion.so/profile/integrations -> public integration
# Redirect URI: http://localhost:8787/api/oauth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# https://linear.app/settings/api/applications
# Redirect URI: http://localhost:8787/api/oauth/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# LINEAR_SCOPES=read,write

# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web)
# Redirect URI: http://localhost:8787/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_SCOPES=openid email profile
