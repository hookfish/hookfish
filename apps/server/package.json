{
  "name": "@template/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/portless-dev.mjs server -- sh -c 'exec wrangler dev --config ./wrangler.jsonc --ip \"${HOST:-127.0.0.1}\" --port \"$PORT\" --inspector-port 0'",
    "dev:app": "wrangler dev --config ./wrangler.jsonc --ip ${HOST:-127.0.0.1} --port ${PORT:-8787} --inspector-port 0",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "deploy": "pnpm build && wrangler deploy --config ./wrangler.jsonc",
    "cf-typegen": "wrangler types --config ./wrangler.jsonc"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@types/node": "^24.12.3",
    "typescript": "~5.9.3",
    "wrangler": "^4.95.0"
  }
}
