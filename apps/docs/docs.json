{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hookfish",
  "colors": {
    "primary": "#15803D",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "concepts/how-it-works",
              "concepts/scopes"
            ]
          },
          {
            "group": "Store secrets",
            "pages": [
              "secrets/api-keys",
              "authentication/oauth-providers",
              "providers/remote-mcp",
              "providers/custom"
            ]
          },
          {
            "group": "Integrate",
            "pages": [
              "frameworks/hono",
              "frameworks/nextjs",
              "frameworks/express",
              "frameworks/browser-dashboard",
              "frameworks/react-hooks"
            ]
          },
          {
            "group": "Deploy",
            "pages": [
              "deployment/choose-backend",
              "deployment/vercel",
              "deployment/bun",
              "deployment/docker",
              "frameworks/cloudflare-workers"
            ]
          },
          {
            "group": "Secure and scale",
            "pages": [
              "authentication/application-auth",
              "authorization/token-scoping"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "operations/cli",
              "operations/inspector",
              "operations/databases",
              "operations/events",
              "operations/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "brackets-curly",
        "groups": [
          {
            "group": "Configuration",
            "pages": [
              "reference/configuration",
              "reference/environment",
              "reference/packages"
            ]
          },
          {
            "group": "HTTP API",
            "pages": ["reference/api", "reference/errors"]
          },
          {
            "group": "Security",
            "pages": ["reference/security"]
          },
          {
            "group": "License",
            "pages": ["reference/license"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/hookfish/hookfish",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/hookfish/hookfish"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/hookfish/hookfish"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  }
}
