{
  "name": "@hookfish/frontend",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host ${FRONTEND_HOST:-${HOST:-127.0.0.1}} --port ${FRONTEND_PORT:-${PORT:-5173}} --strictPort",
    "build": "vite build && tsc --noEmit",
    "build:cli": "FRONTEND_OUT_DIR=../../packages/cli/dist/frontend vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookfish/browser": "workspace:*",
    "@hookfish/client": "workspace:*",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.0",
    "hono": "^4.12.34",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.5"
  }
}
