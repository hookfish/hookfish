# Copy this file to apps/frontend/.env and fill it in. Never commit the real file.
# Node backend examples and local Wrangler read apps/frontend/.env. The static
# frontend only receives variables prefixed with VITE_.

# Point the static SPA at a separate backend origin. Leave unset when using
# `pnpm dev`; Vite proxies `/api` to HOOKFISH_BACKEND_URL or the
# default Node backend at http://127.0.0.1:8787. The root development script
# automatically uses the ports allocated by Conductor when available.
# VITE_BACKEND_URL=http://127.0.0.1:8787

# Browser origin used for CORS and OAuth completion redirects.
# HOOKFISH_FRONTEND_URL=http://127.0.0.1:5173

# --- Broker -----------------------------------------------------------------

# Encrypts access/refresh tokens before they are written to the database.
# Generate with: openssl rand -base64 32
# Changing this makes every stored token unreadable.
OAUTH_ENCRYPTION_KEY=

# Callers must send `Authorization: Bearer <this>` on every endpoint except
# the OAuth callback. Generate with: openssl rand -base64 32
# Outside production, defaults to "test" when unset.
HOOKFISH_API_KEY=

# Public origin the providers redirect back to. Callback URLs are derived as
# <base>/api/oauth/callback/<provider-path>. Required in production; local
# development falls back to the request origin.
# OAUTH_REDIRECT_BASE_URL=https://broker.example.com

# --- Database ---------------------------------------------------------------
# The root Hookfish config currently uses embedded PGlite.
# PGLITE_DATA_DIR=./pgdata
# To use the commented Postgres configuration in hookfish.config.ts:
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/postgres

# Local Hyperdrive connection used by the Cloudflare Worker example:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://user:pass@127.0.0.1:5432/postgres

# --- Providers --------------------------------------------------------------
# Only providers with credentials are reported as configured.

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
