{
  "name": "template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "node ./packages/cli/bin/template.mjs serve",
    "postinstall": "pnpm build",
    "build": "turbo build",
    "typecheck": "turbo typecheck && turbo cf-typecheck",
    "test": "turbo test",
    "prepare": "git config core.hooksPath .githooks",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "preview": "turbo preview",
    "deploy": "turbo deploy",
    "cf-typegen": "turbo cf-typegen",
    "cf-typecheck": "turbo cf-typecheck",
    "db:studio": "pnpm --filter @template/api db:studio",
    "cli": "node ./packages/cli/bin/template.mjs",
    "migrate": "node ./packages/cli/bin/template.mjs migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@template/cli": "workspace:*",
    "@template/provider": "workspace:*",
    "@template/providers": "workspace:*",
    "biome-plugin-no-type-assertion": "^1.1.1",
    "turbo": "^2.6.1"
  }
}
