{
  "name": "template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo dev",
    "portless:url": "turbo run //#portless:urls",
    "portless:urls": "node scripts/portless-url.mjs",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "prepare": "git config core.hooksPath .githooks",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "preview": "turbo preview",
    "deploy": "turbo deploy",
    "cf-typegen": "turbo cf-typegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "biome-plugin-no-type-assertion": "^1.1.1",
    "portless": "^0.14.0",
    "turbo": "^2.6.1"
  }
}
