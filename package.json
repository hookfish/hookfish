{
  "name": "hookfish-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "node ./packages/cli/bin/hookfish.mjs repo-dev",
    "docs": "cd apps/docs && mint dev",
    "build": "turbo build",
    "build:publish": "turbo build --filter='./packages/**'",
    "typecheck": "turbo typecheck && turbo cf-typecheck",
    "test": "turbo test",
    "prepare": "git config core.hooksPath .githooks",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "preview": "turbo preview",
    "deploy": "turbo deploy",
    "cf-typegen": "turbo cf-typegen",
    "cf-typecheck": "turbo cf-typecheck",
    "db:studio": "pnpm --filter @hookfish/api db:studio",
    "cli": "node ./packages/cli/bin/hookfish.mjs",
    "migrate": "node ./packages/cli/bin/hookfish.mjs migrate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "sync-license": "node scripts/sync-license.mjs",
    "release": "pnpm build:publish && pnpm sync-license && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^3.0.0",
    "@hookfish/api": "workspace:*",
    "@hookfish/backend": "workspace:*",
    "hookfish": "workspace:*",
    "@hookfish/database": "workspace:*",
    "@hookfish/provider": "workspace:*",
    "@hookfish/providers": "workspace:*",
    "@hookfish/sdk": "workspace:*",
    "biome-plugin-no-type-assertion": "^1.1.1",
    "turbo": "^2.6.1"
  }
}
