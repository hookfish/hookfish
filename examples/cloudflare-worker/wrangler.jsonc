{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "template-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HOOKFISH_DB",
        "class_name": "HookfishDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HookfishDurableObject"]
    }
  ]
}
