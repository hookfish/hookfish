{
  "name": "@hookfish/example-cloudflare-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env-file ../../apps/frontend/.env --port ${PORT:-8787}",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-file wrangler-typegen.env",
    "cf-typecheck": "wrangler types --env-file wrangler-typegen.env --check"
  },
  "dependencies": {
    "@hookfish/api": "workspace:*",
    "@hookfish/database": "workspace:*",
    "@hookfish/providers": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.19",
    "@types/node": "^24.12.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  }
}
