{
  "name": "@hookfish/example-chatbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:run": "tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/with-database.ts db:migrate",
    "db:studio:run": "drizzle-kit studio --config drizzle.config.ts",
    "db:studio": "tsx scripts/with-database.ts db:studio",
    "dev:run": "pnpm db:migrate:run && next dev --hostname ${HOST:-localhost} --port ${PORT:-3000}",
    "dev": "tsx scripts/with-database.ts dev",
    "build:run": "pnpm db:migrate:run && next build",
    "build": "tsx scripts/with-database.ts build",
    "start:run": "pnpm db:migrate:run && next start --hostname ${HOST:-localhost} --port ${PORT:-3000}",
    "start": "tsx scripts/with-database.ts start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/react": "^4.0.65",
    "@base-ui/react": "^1.7.0",
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@hookfish/api": "workspace:*",
    "@hookfish/sdk": "workspace:*",
    "@next/env": "^16.3.0",
    "@shadcn/react": "^0.3.0",
    "ai": "^7.0.62",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "~5.9.3"
  }
}
