{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vinxi/**"]
    },
    "@hookfish/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/database#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/providers#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/provider#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/provider-github#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/provider-linear#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/provider-notion#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/provider-github#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/provider-linear#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/provider-notion#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/example-cloudflare-worker#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hookfish/example-hono-node#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "cf-typegen": {
      "cache": false,
      "outputs": []
    },
    "cf-typecheck": {
      "cache": false,
      "outputs": []
    }
  }
}
