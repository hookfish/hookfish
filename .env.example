# Copy to .env (gitignored) and fill in. Deploy-time only -- everything here is
# specific to your Cloudflare account, so it must never be committed.
#
#   cp .env.example .env
#
# `pnpm run deploy` reads this file and never uploads it. Runtime secrets belong
# in apps/<app>/.env instead, which does get uploaded with each version.
#
# Real environment variables win over this file, so CI can supply the same names
# as repository secrets and skip it entirely.

# --- Cloudflare account -----------------------------------------------------
#
# Read by wrangler itself. `wrangler login` covers both locally; in CI, create a
# scoped API token (Workers Scripts: Edit) instead.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Database ---------------------------------------------------------------
#
# Hyperdrive config id, injected as the HYPERDRIVE binding at deploy time by
# scripts/wrangler-deploy.mjs. Create one against your Postgres with:
#
#   pnpm --filter @template/server exec wrangler hyperdrive create <name> \
#     --connection-string="postgres://user:pass@host:5432/dbname"
#
# The id is not a credential -- the database password lives inside the
# Hyperdrive config on Cloudflare's side, not here -- but it does identify your
# account's resource, so it stays out of git.
#
# Leave unset to skip Hyperdrive entirely and connect over a DATABASE_URL
# secret instead (`wrangler secret put DATABASE_URL`).
# HYPERDRIVE_ID=

# --- Worker names -----------------------------------------------------------
#
# Overrides the `name` in wrangler.jsonc. Set per app rather than here, since
# each Worker needs its own -- apps/frontend/.env and apps/server/.env are read
# first and both are gitignored.
# WORKER_NAME=
