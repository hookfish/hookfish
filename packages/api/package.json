{
  "name": "@template/api",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "src",
    "drizzle",
    "OAUTH.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pglite": {
      "types": "./src/db/pglite.ts",
      "default": "./src/db/pglite.ts"
    },
    "./postgres": {
      "types": "./src/db/postgres.ts",
      "default": "./src/db/postgres.ts"
    },
    "./local-node": {
      "types": "./src/local-node.ts",
      "default": "./src/local-node.ts"
    },
    "./oauth/config": {
      "types": "./src/oauth/config.ts",
      "default": "./src/oauth/config.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.4.0",
    "@template/provider": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "postgres": "^3.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@template/providers": "workspace:*",
    "@types/node": "^24.12.3",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
