{
  "name": "@hookfish/api",
  "version": "0.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hookfish/hookfish.git",
    "directory": "packages/api"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src",
    "drizzle",
    "OAUTH.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./database": {
      "types": "./src/db/index.ts",
      "default": "./src/db/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./migrations": {
      "types": "./src/migrations.ts",
      "default": "./src/migrations.ts"
    },
    "./oauth/config": {
      "types": "./src/oauth/config.ts",
      "default": "./src/oauth/config.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.4.0",
    "@hookfish/provider": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hookfish/providers": "workspace:*",
    "@types/node": "^24.12.3",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
