{
  "name": "hookfish",
  "version": "0.7.0",
  "description": "CLI for Hookfish",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamath/hookfish.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "hookfish": "./bin/hookfish.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "start": "node ./bin/hookfish.mjs"
  },
  "dependencies": {
    "@hookfish/database": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
