{
  "name": "hookfish",
  "version": "0.8.4",
  "description": "CLI for Hookfish",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamath/hookfish.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "hookfish": "./bin/hookfish.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @hookfish/frontend build:cli && pnpm --filter @hookfish/inspector build:cli",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "start": "node ./bin/hookfish.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hookfish/database": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tanstack/react-router": "^1.170.25",
    "commander": "^14.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "srvx": "^0.11.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hookfish/inspector": "workspace:*",
    "@types/node": "^24.12.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
