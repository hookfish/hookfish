    "generate": "tsx ./scripts/generate-openapi.ts && openapi-ts && tsx ./scripts/patch-generated.ts",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@hookfish/api": "workspace:*",
    "@types/node": "^24.12.3",
    "hono": "^4.12.34",
    "tsx": "4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
