{
  "name": "@hookfish/database",
  "version": "1.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/hookfish/hookfish.git",
    "directory": "packages/database"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pglite": {
      "types": "./dist/pglite.d.ts",
      "default": "./dist/pglite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./durable-object": {
      "types": "./dist/durable-object.d.ts",
      "default": "./dist/durable-object.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hookfish/api": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@types/node": "^24.12.3",
    "typescript": "~5.9.3"
  }
}
