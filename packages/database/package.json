{
  "name": "@hookfish/database",
  "version": "0.4.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/hookfish/hookfish.git",
    "directory": "packages/database"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pglite": {
      "types": "./src/pglite.ts",
      "default": "./src/pglite.ts"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "default": "./src/postgres.ts"
    },
    "./durable-object": {
      "types": "./src/durable-object.ts",
      "default": "./src/durable-object.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hookfish/api": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@types/node": "^24.12.3",
    "typescript": "~5.9.3"
  }
}
